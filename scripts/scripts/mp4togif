#!/bin/bash

# Default values
FPS=15
SCALE=1280

# Help message
show_help() {
    echo "Usage: mp4togif [OPTIONS] <input.mp4>"
    echo ""
    echo "Options:"
    echo "  -f, --fps <number>     Frame rate (default: 15)"
    echo "  -s, --scale <width>    Scale width in pixels (default: 1280)"
    echo "  -h, --help             Show this help message"
    echo ""
    echo "Examples:"
    echo "  mp4togif video.mp4"
    echo "  mp4togif -f 20 -s 1920 video.mp4"
    echo "  mp4togif --fps 10 --scale 640 video.mp4"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--fps)
            FPS="$2"
            shift 2
            ;;
        -s|--scale)
            SCALE="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            echo "Error: Unknown option $1"
            show_help
            exit 1
            ;;
        *)
            INPUT_FILE="$1"
            shift
            ;;
    esac
done

# Check if a file was provided
if [ -z "$INPUT_FILE" ]; then
    echo "Error: No input file provided"
    show_help
    exit 1
fi

# Check if the file exists
if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: File '$INPUT_FILE' not found"
    exit 1
fi

# Check if ffmpeg is installed
if ! command -v ffmpeg &> /dev/null; then
    echo "Error: ffmpeg is not installed"
    echo "Install it with: sudo apt install ffmpeg"
    exit 1
fi

# Validate FPS is a number
if ! [[ "$FPS" =~ ^[0-9]+$ ]]; then
    echo "Error: FPS must be a positive integer"
    exit 1
fi

# Validate SCALE is a number
if ! [[ "$SCALE" =~ ^[0-9]+$ ]]; then
    echo "Error: Scale must be a positive integer"
    exit 1
fi

# Extract output filename
output="${INPUT_FILE%.*}.gif"

# Check if output file already exists
if [ -f "$output" ]; then
    read -p "Warning: '$output' already exists. Overwrite? (y/n): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        exit 0
    fi
fi

# Run the conversion
echo "Converting '$INPUT_FILE' to '$output'..."
echo "Settings: ${FPS}fps, ${SCALE}px width"
if ffmpeg -i "$INPUT_FILE" -vf "fps=${FPS},scale=${SCALE}:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" "$output"; then
    echo "Success! Created: $output"
else
    echo "Error: Conversion failed"
    exit 1
fi
