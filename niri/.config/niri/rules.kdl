// Global window rules
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Border for screen-casted windows
window-rule {
    match is-window-cast-target=true
    focus-ring {
        active-gradient from="#ff0000" to="#00ff99" angle=180 
        inactive-gradient from="#ff0000" to="#ffff00" angle=180 
    }
}

window-rule {
    match app-id="vlc"
    open-floating true
}

window-rule {
    match app-id="org.kde.konsole"
    background-effect {
        blur true
    }
}

window-rule {
    match title=r#"RuneLite.*"# app-id="net-runelite-client-RuneLite"
    open-on-output "DP-1"
    open-floating true
    open-focused true
    // opacity 0.2
}


window-rule {
    match app-id="com.gabm.satty"
    open-floating true
}

window-rule {
    match app-id="com.obsproject.Studio"
    open-on-workspace "Streaming and Recording"
}

window-rule {
    match app-id="firefox" at-startup=true
    open-on-workspace "Main"
}

window-rule {
    match title=r#"(?i)discord"#
    open-on-workspace "Chat"
    open-maximized true
}

window-rule {
    match title=r#"(?i)steam"#
    open-on-workspace "Games"
}

// KakaoTalk notifications
// todo: block out from screen-capture
window-rule {
    match app-id="kakaotalk.exe" title=r#"$^"#
    default-floating-position x=10 y=200 relative-to="bottom-right"
    open-focused false
    open-on-output "DP-1"
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=20 relative-to="bottom-right"
    open-focused false 
    block-out-from "screencast"
    open-on-output "DP-1"
}

window-rule {
    match app-id="net.lutris.Lutris"
    open-on-workspace "Games"
}

window-rule {
    match app-id="com.adamcake.Bolt" title="Bolt Launcher"
    open-on-workspace "Games"
}

window-rule {
    match app-id="kakaotalk.exe" title=r#"(?i)kakaotalk"#
    open-on-workspace "scratch"
    open-floating true
    open-focused false
    min-width 440
    max-width 440
    min-height 680
    max-height 680
}

window-rule {
    match app-id="kakaotalk.exe"
    open-floating true
    open-focused false
}

window-rule {
    match app-id="explorer.exe"
    open-on-workspace "scratch"
    open-floating true
    open-focused false
}

window-rule {
    match app-id="showmethekey-gtk"
    open-floating true
    open-on-workspace "SMTK"
    min-width 405
    max-width 405
    min-height 55
    max-height 55
    default-floating-position x=668 y=1820
}

window-rule {
    match app-id="one.alynx.showmethekey"
    open-on-workspace "SMTK"
    open-maximized true
}

window-rule {
    match title="LocalSend"
    open-on-workspace "scratch"
    open-floating true
    open-focused false
}

window-rule {
    match app-id="Spotify" 
    open-floating true
    open-on-workspace "scratch"
    open-focused false
}

window-rule {
    match app-id="org.gnome.Nautilus"
    open-floating true
    open-focused true
}

layer-rule {
    match namespace="^rofi$"

    baba-is-float true

}
